<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the Compose UI, also shown while the app starts,
         in the surface colour of the light or dark theme the system has
         (from Android 12, the app's, as TidemeldApp tells the system). Once
         running, TidemeldApp repaints it in the theme the app has. -->
    <style name="Theme.Tidemeld" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
